     unsigned int    bits;
@@ -264,6 +270,79 @@
 }
 
 /* ------------------------------------------------------------------------ */
+/* -lh2- ENCODING, added by the MacExtract project (not upstream).
+
+   Upstream decodes -lh2- and cannot write it, so nothing reachable makes
+   one and a decoder for it cannot be graded. These are the mirror of
+   decode_p_dyn below; archives they produce are verified by THIS
+   program's own decoder before anything else reads them. */
+unsigned long
+encode_p_dyn_maxoff(void)
+{
+    /* The largest offset the position tree can express WITHOUT advancing
+       it: the caller decides literal-or-match before a symbol is emitted,
+       and the decoder only grows the tree when it decodes a position. */
+    unsigned long pending = 0, nc = nextcount;
+
+    while (nc != 0xffffffff && (unsigned long)encode_count > nc) {
+        pending++;
+        nc += 64;
+        if (nc >= (unsigned)nn)
+            nc = 0xffffffff;
+    }
+    return ((unsigned long)(p_nodes + pending) << 6) - 1;
+}
+
+void
+encode_p_dyn(unsigned int off)
+{
+    unsigned int bits;
+    int p, cnt;
+    unsigned int j = off >> 6;
+
+    while ((unsigned long)encode_count > nextcount) {
+        make_new_node(nextcount / 64);
+        if ((nextcount += 64) >= (unsigned)nn)
+            nextcount = 0xffffffff;
+    }
+    cnt = bits = 0;
+    p = s_node[j + N_CHAR];
+    /* While the tree has ONE leaf it IS the root, and the decoder reads no
+       bits for it (its `while (c > 0)` never runs). Walking up from the
+       root instead of emitting nothing is an infinite loop. */
+    if (p != ROOT_P) {
+        do {
+            bits >>= 1;
+            if (p & 1)
+                bits |= 0x80000000L;
+            cnt++;
+        } while ((p = parent[p]) != ROOT_P);
+    }
+    if (cnt > 0) {
+        if (cnt <= 16)
+            putcode(cnt, bits >> 16);
+        else {
+            putcode(16, bits >> 16);
+            putbits(cnt - 16, bits);
+        }
+    }
+    putbits(6, off & 0x3f);
+    update_p(j);
+}
+
+void
+encode_start_dyn(void)
+{
+    p_nodes = 1;
+    n_max = 286;
+    maxmatch = MAXMATCH;
+    init_putbits();
+    encode_count = 0;
+    start_c_dyn();
+    start_p_dyn();
+}
+
+/* ------------------------------------------------------------------------ */
 /* lh1, 2 */
 unsigned short
 decode_c_dyn( /* void */ )
