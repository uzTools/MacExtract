# Build outputs
build/
*.o
*.a
unclassic

# Fixture archives are copyrighted software — never committed.
# Only manifests + SOURCES.md (provenance) are tracked.
fixtures/*
!fixtures/manifests/
!fixtures/SOURCES.md

# Reference material is fetched by tools/fetch_references.sh, not committed.
reference/
build-mac/
build-mac-*/

# Python bytecode. Anchored at the repo root rather than at tools/, because
# tools/vmac/ and tools/quickdraw-repro/ each import the other's modules and so
# generate their own __pycache__ — three of which got committed before this.
**/__pycache__/

# Bootstrap distribution build outputs (regenerated by tools/make_dist.sh)
dist/*.bin
dist/*.dsk
